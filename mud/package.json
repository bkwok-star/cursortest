{
  "name": "mud",
  "version": "1.0.0",
  "description": "Modern MUD game with Node.js, TypeScript, and Socket.io",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/index.js",
    "dev": "ts-node-dev --respawn --transpile-only server/index.ts",
    "clean": "rm -rf dist"
  },
  "keywords": ["mud", "multi-user", "socket.io", "typescript"],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
